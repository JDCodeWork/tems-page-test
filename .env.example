# Copia este archivo como .env para conectar el sitio a Strapi en local.
# Si STRAPI_URL no está definido se usa el contenido de ejemplo de src/lib/content.ts.

# URL base de Strapi, SIN /api al final
STRAPI_URL=http://localhost:1337

# API token de Strapi (Settings → API Tokens → tipo "Read-only")
STRAPI_TOKEN=

# Dominio público del sitio (canonical, Open Graph, sitemap).
# En Netlify no hace falta: se usa la variable URL que Netlify define.
SITE_URL=

# Secreto compartido con Strapi para la vista previa de borradores (/preview).
# Debe ser igual al PREVIEW_SECRET de Strapi. Ver docs/preview.md.
PREVIEW_SECRET=
