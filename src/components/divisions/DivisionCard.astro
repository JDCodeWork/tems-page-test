---
import { ArrowRight } from '@lucide/astro'
import { cn } from '@/lib/utils'
import CmsIcon from '../ui/CmsIcon.astro'
import Blob1 from '@/assets/hero/blob-1.svg'
import type { DivisionColor } from '@/types'

interface Item {
  text: string
  icon: string
}

interface CtaButton {
  text: string
  url: string
}


interface Props {
  title: string
  subtitle: string
  items: Item[]
  cta: CtaButton
  color?: DivisionColor
}

const { subtitle, title, cta, items, color = 'orange' } = Astro.props

const themes = {
  orange: {
    accent: 'bg-primary',
    text: 'text-primary',
    button: 'bg-primary hover:bg-primary-dark focus-visible:ring-primary',
  },
  blue: {
    accent: 'bg-secondary-dark',
    text: 'text-secondary-dark',
    button: 'bg-secondary-dark hover:bg-secondary focus-visible:ring-secondary-dark',
  },
  violet: {
    accent: 'bg-violet-700',
    text: 'text-violet-700',
    button: 'bg-violet-700 hover:bg-violet-800 focus-visible:ring-violet-700',
  },
  green: {
    accent: 'bg-emerald-700',
    text: 'text-emerald-700',
    button: 'bg-emerald-700 hover:bg-emerald-800 focus-visible:ring-emerald-700',
  },
} satisfies Record<DivisionColor, Record<'accent' | 'text' | 'button', string>>

const theme = themes[color as DivisionColor] ?? themes.orange
---

<article class='relative isolate overflow-hidden rounded-3xl bg-white p-6 sm:p-8'>
  <Blob1
    class={cn('absolute top-0 -right-32 scale-[-160%]', theme.text)}
    area-hidden='true'
    focusable='false'
  />
  <header class='relative flex items-center gap-3'>
    <div
      class={cn('grid size-14 shrink-0 place-items-center rounded-full text-white', theme.accent)}
    >
      <CmsIcon
        name={items[0]?.icon ?? 'circle-help'}
        size={30}
      />
    </div>
    <div>
      <h4 class={cn('font-title text-3xl font-bold leading-none', theme.text)}>
        {title}
      </h4>
    </div>
  </header>
  <p class='mt-4 text-sm text-foreground'>{subtitle}</p>
  <ul class='relative mt-5 space-y-3'>
    {
      items.map((el) => (
        <li class='flex items-center gap-3 text-sm font-medium text-foreground'>
          <CmsIcon
            name={el.icon}
            size={18}
            class={theme.text}
          />
          <span>{el.text}</span>
        </li>
      ))
    }
  </ul>

  <a
    href={cta.url}
    class={cn(
      'relative mt-7 flex w-full items-center justify-center gap-3 rounded-full px-5 py-3 text-sm font-bold text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2',
      theme.button,
    )}
  >
    {cta.text}
    <ArrowRight
      size={20}
      aria-hidden='true'
    />
  </a>
</article>
