---
import Rectangles2 from '@/assets/hero/rectangles-2.svg'
import Rectangles1 from '@/assets/hero/rectangles-1.svg'

import Elipse from '@/assets/hero/elipse-1.svg'
---

<div
  class='absolute bottom-12 md:bottom-1/2 md:translate-y-1/2 -right-6 md:left-1/2 md:translate-x-1/4'
>
  <div class='hero-image-enter *:absolute relative w-36 md:w-56 lg:w-66 xl:w-76 h-68 md:h-106 lg:h-126 xl:h-146'>
    <div class='inset-0 rounded-full overflow-hidden z-10'>
      <img
        src='/hero-sm-img.webp'
        srcset='
          /hero-sm-img.webp 1x,
          /hero-md-img.webp 2x'
        alt='Letrero #UNAL en el campus de la Universidad Nacional de Colombia'
        fetchpriority='high'
        class='w-full h-full object-cover'
      />
    </div>

    <Elipse
      class='-bottom-8 md:bottom-4 lg:bottom-14 xl:bottom-16 -right-8 md:right-8 lg:right-4 xl:right-8 z-0 scale-85 md:scale-125 xl:scale-150'
    />

    <Rectangles1
      class='drift-slow top-12 lg:top-24 xl:top-32 -left-20 lg:-left-26 xl:-left-36 hidden lg:block z-20 scale-60 lg:scale-100 xl:scale-150'
    />
    <Rectangles2
      class='float-slower bottom-0 xl:bottom-8 -right-20 lg:-right-26 xl:-right-36 hidden lg:block z-20 scale-60 lg:scale-100 xl:scale-150'
    />
  </div>
</div>
