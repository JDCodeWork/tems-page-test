---
import { UserRound } from '@lucide/astro'
import RemoteImage from '@/components/ui/RemoteImage.astro'
import SocialIcon from '@/components/ui/SocialIcon.astro'
import type { TeamMember } from '@/types'

interface Props {
  member: TeamMember
  /** Reemplaza el rol general (ej. su rol dentro de un proyecto). */
  role?: string
}

const { member, role = member.role } = Astro.props
---

<article class='group flex h-full flex-col items-center rounded-2xl bg-white p-4 pb-5 text-center shadow-[0_2px_14px_-6px_rgb(0_11_25/0.1)] transition duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_10px_24px_-10px_rgb(0_11_25/0.16)]'>
  <div
    class='grid aspect-[4/5] w-full place-items-end overflow-hidden rounded-t-full bg-amber-300 text-secondary-dark/70'
  >
    {
      member.photo ? (
        <RemoteImage
          media={member.photo}
          width={240}
          class='size-full object-cover transition-transform duration-500 ease-out group-hover:scale-105'
        />
      ) : (
        <UserRound
          class='mx-auto size-3/4 translate-y-[12%] transition-transform duration-500 ease-out group-hover:translate-y-[8%]'
          stroke-width={1.25}
          aria-hidden='true'
        />
      )
    }
  </div>
  <h3 class='mt-4 font-title text-sm font-bold'>{member.name}</h3>
  <p class='mt-1 text-xs text-foreground/70'>{role}</p>
  <div class='mt-auto flex gap-3 pt-4'>
    {
      member.social.linkedin && (
        <a
          href={member.social.linkedin}
          target='_blank'
          rel='noopener noreferrer'
          class='grid size-8 place-items-center rounded-full bg-foreground text-white transition-colors hover:bg-primary'
          aria-label={`LinkedIn de ${member.name}, se abre en una pestaña nueva`}
        >
          <SocialIcon name='linkedin' size={14} />
        </a>
      )
    }
    {
      member.social.email && (
        <a
          href={member.social.email}
          class='grid size-8 place-items-center rounded-full bg-foreground text-white transition-colors hover:bg-primary'
          aria-label={`Correo de ${member.name}`}
        >
          <SocialIcon name='mail' size={14} />
        </a>
      )
    }
  </div>
</article>
