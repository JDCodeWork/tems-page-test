---
import { ArrowRight } from '@lucide/astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import type { Project } from '@/types'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
const featured = projects.filter((project) => project.featured)
const shown = featured.length > 0 ? featured : projects.slice(0, 3)
// Con 1 o 2 proyectos el título va como columna lateral; con más, arriba.
const sideTitle = shown.length <= 2
---

<section
  id='proyectos'
  class='scroll-mt-4 bg-background px-page py-12 md:py-16'
>
  <!--
    Móvil: todo apilado.
    md: título arriba + tarjetas en 2 columnas.
    lg+ (1–2 proyectos): título como columna lateral.
  -->
  <div
    class={sideTitle
      ? 'grid gap-6 md:grid-cols-2 md:gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1fr)_minmax(0,1fr)] xl:gap-10'
      : 'grid gap-6 md:grid-cols-2 md:gap-8 lg:grid-cols-3 xl:gap-10'}
    data-reveal-stagger
  >
    <div class={sideTitle ? 'space-y-6 md:col-span-2 lg:col-span-1 lg:pt-10' : 'space-y-6 md:col-span-2 lg:col-span-3'}>
      <h2 class='relative w-fit text-3xl font-bold md:text-4xl lg:text-3xl xl:text-4xl'>
        Nuestros proyectos
        <span class='absolute -bottom-3 left-0 h-1 w-12 rounded-full bg-primary'></span>
      </h2>
      <p class='max-w-md text-sm sm:text-base xl:text-lg'>
        Distintos caminos, un mismo propósito: aprender, construir y transformar.
      </p>
      <a
        href='/proyectos'
        class='group inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark'
      >
        Ver todos los proyectos
        <ArrowRight size={18} class='transition-transform group-hover:translate-x-1' aria-hidden='true' />
      </a>
    </div>

    {shown.map((project, i) => <ProjectCard project={project} index={i} />)}

    {
      shown.length === 0 && (
        <p class='rounded-2xl bg-white p-6 text-center text-sm text-foreground/70 md:col-span-2'>
          Muy pronto publicaremos nuestros proyectos.
        </p>
      )
    }
  </div>
</section>
