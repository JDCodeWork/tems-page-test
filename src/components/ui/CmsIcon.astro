---
import * as LucideIcons from '@lucide/astro'
import type { AstroComponent } from '@lucide/astro'

interface Props {
  /** Nombre de un icono de Lucide recibido desde el CMS. */
  name: string
  class?: string
  size?: number | string
}

const { name, class: className, size = 24 } = Astro.props

/** Convierte `graduation-cap`, `graduation_cap` o `GraduationCap` a `GraduationCap`. */
const iconName = name
  .trim()
  .split(/[-_\s]+/)
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join('')

const candidate = LucideIcons[iconName as keyof typeof LucideIcons]
const Icon = typeof candidate === 'function' ? (candidate as AstroComponent) : LucideIcons.CircleHelp
---

<Icon class={className} size={size} aria-hidden="true" />
