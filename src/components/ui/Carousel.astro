---
import { ChevronLeft, ChevronRight } from '@lucide/astro'
import { cn } from '@/lib/utils'

interface Props {
  label: string
  /** Clases extra para la pista (gap, padding, etc). */
  trackClass?: string
  /** Dónde se muestran los puntos de paginación. */
  dots?: 'mobile' | 'always' | 'none'
}

const { label, trackClass = '', dots = 'mobile' } = Astro.props

const arrowClass =
  'absolute top-1/2 z-10 hidden -translate-y-1/2 place-items-center size-10 rounded-full bg-white text-foreground shadow-md transition hover:bg-primary hover:text-white disabled:invisible md:grid'
---

<div
  class='relative'
  data-carousel
  role='region'
  aria-roledescription='carrusel'
  aria-label={label}
>
  <button
    type='button'
    class={cn(arrowClass, '-left-5 lg:-left-12')}
    aria-label='Anterior'
    data-carousel-prev
  >
    <ChevronLeft size={20} aria-hidden='true' />
  </button>

  <div
    class={cn(
      'flex snap-x snap-mandatory overflow-x-auto motion-safe:scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
      trackClass,
    )}
    data-carousel-track
  >
    <slot />
  </div>

  <button
    type='button'
    class={cn(arrowClass, '-right-5 lg:-right-12')}
    aria-label='Siguiente'
    data-carousel-next
  >
    <ChevronRight size={20} aria-hidden='true' />
  </button>

  <div
    class={cn(
      'mt-6 flex justify-center gap-2',
      dots === 'mobile' && 'md:hidden',
      dots === 'none' && 'hidden',
    )}
    data-carousel-dots
    role='group'
    aria-label='Elegir elemento'
  >
  </div>
</div>

<script>
  function setupCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]')
    const dotsContainer = root.querySelector<HTMLElement>('[data-carousel-dots]')
    if (!track || !prev || !next || !dotsContainer) return

    const slides = Array.from(track.children) as HTMLElement[]
    slides.forEach((slide, i) => {
      slide.setAttribute('role', 'group')
      slide.setAttribute('aria-roledescription', 'elemento')
      slide.setAttribute('aria-label', `${i + 1} de ${slides.length}`)
    })
    const step = () => (slides[0]?.offsetWidth ?? track.clientWidth) + parseFloat(getComputedStyle(track).columnGap || '0')

    const dots = slides.map((_, i) => {
      const dot = document.createElement('button')
      dot.type = 'button'
      dot.className = 'size-2.5 rounded-full bg-foreground/20 transition-all data-[active=true]:w-6 data-[active=true]:bg-primary'
      dot.setAttribute('aria-label', `Ir al elemento ${i + 1}`)
      dot.addEventListener('click', () => {
        track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft - (track.clientWidth - slides[i].offsetWidth) / 2 })
      })
      dotsContainer.append(dot)
      return dot
    })

    const update = () => {
      const maxScroll = track.scrollWidth - track.clientWidth
      prev.disabled = track.scrollLeft <= 4
      next.disabled = track.scrollLeft >= maxScroll - 4

      const center = track.scrollLeft + track.clientWidth / 2
      let active = 0
      let best = Infinity
      slides.forEach((slide, i) => {
        const slideCenter = slide.offsetLeft - track.offsetLeft + slide.offsetWidth / 2
        const distance = Math.abs(slideCenter - center)
        if (distance < best) {
          best = distance
          active = i
        }
      })
      dots.forEach((dot, i) => {
        dot.dataset.active = String(i === active)
        if (i === active) dot.setAttribute('aria-current', 'true')
        else dot.removeAttribute('aria-current')
      })
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step() }))
    next.addEventListener('click', () => track.scrollBy({ left: step() }))
    track.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(setupCarousel)
</script>
