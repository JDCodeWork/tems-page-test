---
import { Eye, Target } from '@lucide/astro'
import type { About } from '@/types'

interface Props {
  about: About
  /** Cifras calculadas a partir del contenido publicado (se ocultan si son 0). */
  stats: { value: number; label: string }[]
}

const { about, stats } = Astro.props
const visibleStats = stats.filter((stat) => stat.value > 0)
const pillars = [
  { title: 'Misión', text: about.mission, Icon: Target },
  { title: 'Visión', text: about.vision, Icon: Eye },
].filter((pillar) => pillar.text)
---

<section
  id='nosotros'
  class='scroll-mt-4 bg-white/60 px-page py-12 md:py-16'
>
  <div class:list={['grid gap-10', pillars.length > 0 && 'lg:grid-cols-2 lg:gap-16']}>
    <div data-reveal>
      <h2 class='relative w-fit text-3xl font-bold md:text-4xl lg:text-3xl xl:text-4xl'>
        {about.title}
        <span class='absolute -bottom-3 left-0 h-1 w-12 rounded-full bg-primary'></span>
      </h2>
      <p class='mt-8 max-w-2xl text-base leading-relaxed md:text-lg'>{about.intro}</p>

      {
        visibleStats.length > 0 && (
          <dl class='mt-8 grid grid-cols-3 gap-4 sm:flex sm:flex-wrap sm:gap-x-10 sm:gap-y-4'>
            {visibleStats.map((stat) => (
              <div class='flex flex-col-reverse items-center text-center sm:min-w-24'>
                <dt class='text-xs leading-snug text-foreground/70 sm:text-sm'>{stat.label}</dt>
                <dd class='font-title text-4xl font-bold leading-tight text-primary'>{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    {
      pillars.length > 0 && (
        <div class='grid gap-5 sm:grid-cols-2 lg:grid-cols-1' data-reveal-stagger>
          {pillars.map(({ title, text, Icon }) => (
            <article class='group flex items-center gap-4 rounded-2xl bg-white p-5 sm:gap-5 sm:p-6 shadow-[0_1px_8px_-4px_rgb(0_11_25/0.08)]'>
              <div class='grid size-13 shrink-0 place-items-center rounded-full bg-primary/10 text-primary transition-transform duration-500 ease-out group-hover:scale-110 sm:size-16'>
                <Icon class='size-7 sm:size-8' aria-hidden='true' />
              </div>
              <div>
                <h3 class='font-title text-lg font-bold'>{title}</h3>
                <p class='mt-1 text-sm leading-relaxed text-foreground/80'>{text}</p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
