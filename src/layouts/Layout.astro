---
import '../styles/global.css'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import { fetchSiteSettings, SITE_NAME } from '@/lib/site'

interface Props {
  /** Título de la página (sin el nombre del sitio). Vacío en la portada. */
  title?: string
  description?: string
  /** Imagen para compartir en redes (URL absoluta o ruta en `public/`). */
  image?: string
  /** La portada pinta su propio header dentro del hero. */
  home?: boolean
  /** Oculta el bloque "¿Quieres hacer parte…?" (ej. en la página Únete). */
  hideJoinCta?: boolean
  noindex?: boolean
}

const settings = await fetchSiteSettings()

const {
  title,
  description = settings.description,
  image = '/og-image.jpg',
  home = false,
  hideJoinCta = false,
  noindex = false,
} = Astro.props

const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} - Technology & Engineering Management Society`
const canonical = new URL(Astro.url.pathname, Astro.site)
const imageUrl = new URL(image, Astro.site)
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{fullTitle}</title>
    <meta name='description' content={description} />
    <link rel='canonical' href={canonical} />
    {noindex && <meta name='robots' content='noindex' />}

    <meta property='og:type' content='website' />
    <meta property='og:locale' content='es_CO' />
    <meta property='og:site_name' content={SITE_NAME} />
    <meta property='og:title' content={fullTitle} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={canonical} />
    <meta property='og:image' content={imageUrl} />
    <meta name='twitter:card' content='summary_large_image' />

    <meta name='theme-color' content='#fd6203' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='icon' href='/favicon.ico' sizes='48x48' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <meta name='generator' content={Astro.generator} />
    <!-- Activa las animaciones de aparición solo si hay JavaScript. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class='flex min-h-svh flex-col bg-background'>
    <a
      href='#contenido'
      class='sr-only rounded-full bg-foreground px-4 py-2 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50'
    >
      Saltar al contenido
    </a>
    {!home && <SiteHeader />}
    <main id='contenido' class='flex-1'>
      <slot />
    </main>
    <SiteFooter settings={settings} hideJoinCta={hideJoinCta} />

    <script>
      // Aparición suave al hacer scroll. `data-reveal-stagger` anima los hijos en cascada.
      const MAX_DELAY = 400
      for (const group of document.querySelectorAll<HTMLElement>('[data-reveal-stagger]')) {
        Array.from(group.children).forEach((child, i) => {
          if (!(child instanceof HTMLElement)) return
          child.dataset.reveal = ''
          child.style.setProperty('--reveal-delay', `${Math.min(i * 90, MAX_DELAY)}ms`)
        })
      }

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]')
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        )
        for (const target of targets) observer.observe(target)
      } else {
        for (const target of targets) target.classList.add('is-visible')
      }
    </script>
  </body>
</html>
