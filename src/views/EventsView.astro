---
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/ui/PageHero.astro'
import EventCard from '@/components/events/EventCard.astro'
import { fetchPastEvents, fetchUpcomingEvents } from '@/lib/events'

const [upcoming, past] = await Promise.all([fetchUpcomingEvents(), fetchPastEvents()])
const description = 'Charlas, talleres y encuentros abiertos a toda la comunidad universitaria.'
---

<Layout title='Eventos' description={description}>
  <PageHero
    title='Eventos'
    description={description}
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Eventos' }]}
  />

  <section class='px-page pb-16'>
    <div class='mx-auto max-w-7xl'>
      <h2 class='font-title text-2xl font-bold md:text-3xl'>Próximos eventos</h2>
      {
        upcoming.length > 0 ? (
          <ul class='mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3' data-reveal-stagger>
            {upcoming.map((event) => (
              <li>
                <EventCard event={event} />
              </li>
            ))}
          </ul>
        ) : (
          <p class='mt-8 rounded-2xl bg-white p-6 text-center text-sm text-foreground/70'>
            Pronto anunciaremos nuevos eventos. ¡Síguenos en redes para enterarte!
          </p>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section class='bg-white/60 px-page py-12 md:py-16'>
        <div class='mx-auto max-w-7xl'>
          <h2 class='font-title text-2xl font-bold md:text-3xl'>Eventos anteriores</h2>
          <ul class='mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3' data-reveal-stagger>
            {past.map((event) => (
              <li>
                <EventCard event={event} class='opacity-80' />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
