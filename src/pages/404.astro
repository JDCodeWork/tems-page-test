---
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/ui/Button.astro'
---

<Layout title='Página no encontrada' noindex>
  <section class='grid place-items-center px-page py-24 text-center'>
    <p class='font-title text-7xl font-black text-primary md:text-9xl'>404</p>
    <h1 class='mt-4 font-title text-2xl font-bold md:text-3xl'>No encontramos esta página</h1>
    <p class='mt-3 max-w-md text-foreground/80'>
      Puede que el enlace esté mal escrito o que el contenido ya no exista.
    </p>
    <div class='mt-8 flex flex-wrap justify-center gap-3'>
      <Button asLink href='/'>Volver al inicio</Button>
      <Button asLink href='/proyectos' variant='outline'>Ver proyectos</Button>
    </div>
  </section>
</Layout>
