---
import { ArrowRight } from '@lucide/astro'
import IeeTemsLogo from '@assets/iee-tems-logo.svg'
import { socialLinks } from '@/lib/content'
import Button from '@/components/ui/Button.astro'
import SocialIcon from '@/components/ui/SocialIcon.astro'
---

<footer
  id='contacto'
  class='relative isolate overflow-hidden bg-[#0b2545] px-8 py-14 text-white md:px-24 md:py-12'
>
  {
    [
      'left-0 top-0 -translate-x-1/2 -translate-y-1/2 md:top-auto md:bottom-0 md:-translate-x-1/3 md:translate-y-1/3',
      'right-0 top-0 translate-x-1/2 -translate-y-1/3 rotate-180 md:translate-x-1/3 md:top-auto md:bottom-0 md:translate-y-1/3 md:rotate-90',
    ].map((position) => (
      <svg
        class={`absolute -z-10 size-28 text-primary md:size-44 ${position}`}
        viewBox='0 0 200 200'
        aria-hidden='true'
        focusable='false'
      >
        <path
          fill='currentColor'
          d='M44.7-62.8C57.4-52.6 66.4-38.4 71.3-22.6 76.2-6.8 77-10.6 72.6 24.3 68.2 41.5 58.6 58.4 44.1 67.7 29.6 77 10.2 78.7-8.6 76.2-27.4 73.7-45.6 67-58.7 54.6-71.8 42.2-79.8 24.1-80.7 5.9-81.6-12.3-75.4-30.6-63.7-41.6-52-52.6-34.8-56.3-19.3-64.4-3.8-72.5 10-85 23.3-82.6 36.6-80.2 32-73 44.7-62.8Z'
          transform='translate(100 100)'
        />
      </svg>
    ))
  }

  <div
    class='mx-auto flex max-w-6xl flex-col gap-10 md:flex-row md:items-center md:justify-between'
  >
    <div class='flex flex-col gap-8 md:flex-row md:items-center md:gap-16'>
      <div class='max-w-sm space-y-3'>
        <h2 class='font-title text-3xl font-bold leading-tight md:text-2xl lg:text-3xl'>
          ¿Quieres hacer parte de TEMS UNAL?
        </h2>
        <p class='text-base leading-relaxed text-white/85 md:text-sm lg:text-base'>
          Sé parte de una comunidad que aprende, construye y transforma el futuro.
        </p>
      </div>
      <Button
        asLink
        href='#'
        class='w-fit px-8 py-3 text-base'
      >
        Únete ahora <ArrowRight size={20} />
      </Button>
    </div>

    <div class='flex flex-col gap-4 md:border-l md:border-white/20 md:pl-14'>
      <IeeTemsLogo
        class='-my-6 -ml-4 h-auto w-56 text-white'
        role='img'
        aria-label='IEEE TEMS - Universidad Nacional de Colombia'
      />
      <ul class='flex gap-4'>
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.url}
                class='grid size-9 place-items-center rounded-full bg-white/10 transition-colors hover:bg-primary'
                aria-label={link.name}
              >
                <SocialIcon name={link.icon} size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
