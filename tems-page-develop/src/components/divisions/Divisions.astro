---
import DivisionCard from '@/components/divisions/DivisionCard.astro'
import { fetchDivisions } from '@/lib/divisions'

const divisions = await fetchDivisions()
---

<section
  id='divisiones'
  class='px-4 py-12 space-y-8 bg-background md:grid md:grid-cols-6 md:px-24 md:gap-24 md:*:col-span-2'
>
  <div class='space-y-4'>
    <h3 class='text-3xl font-bold relative'>
      Nuestras divisiones <span class='bg-primary/75 h-1 w-1/3 absolute -bottom-2 left-0'></span>
    </h3>
    <p class='text-sm lg:text-base xl:text-lg max-w-4/5'>
      Dos caminos, un mismo propósito: aprender, construir y transformar.
    </p>
  </div>

  {
    divisions.map((division) => (
      <DivisionCard
        title={division.title}
        subtitle={division.subtitle}
        color={division.color}
        cta={division.cta}
        items={division.items}
      />
    ))
  }
</section>
