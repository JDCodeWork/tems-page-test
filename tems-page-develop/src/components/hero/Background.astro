---
import Wave1 from '@/assets/hero/wave-1.svg'
import Blob1 from '@/assets/hero/blob-1.svg'
import Blob2 from '@/assets/hero/blob-2.svg'
import { ChevronDownIcon } from '@lucide/astro'

import Rectangles3 from '@/assets/hero/rectangles-3.svg'
---

<Wave1
  class='absolute top-0 -left-32 text-orange-400/30 max-h-dvh -scale-y-100 hidden md:block'
  area-hidden='true'
  focusable='false'
/>

<Wave1
  class='absolute -top-48 -right-32 text-amber-500/40 max-h-dvh -scale-x-100 hidden md:block'
  area-hidden='true'
  focusable='false'
/>
<Blob1
  class='absolute top-28 -right-18 lg:-right-14 xl:-right-12 -scale-x-100 text-orange-500/60 max-h-dvh hidden md:block'
  area-hidden='true'
  focusable='false'
/>
<Blob2
  class='absolute top-full [@media(max-height:630px)]:hidden -translate-y-80 md:-translate-y-72 left-1/2 -translate-x-1/4 md:-translate-x-1/2 rotate-115 text-yellow-500/20 max-h-dvh scale-50 lg:scale-75 xl:scale-100'
  area-hidden='true'
  focusable='false'
/>

<ChevronDownIcon
  class='hidden md:block absolute bottom-4 left-36 text-primary scale-300 stroke-3 animate-bounce animate-duration-3000'
/>

<Rectangles3 class='absolute bottom-8 left-6 md:hidden [@media(max-height:630px)]:hidden' />
