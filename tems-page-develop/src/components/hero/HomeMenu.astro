---
const sections = ['Inicio', 'Nosotros', 'Eventos', 'Proyectos']
---

<div
  class='absolute top-full order-2 md:basis-0 md:ml-auto md:top-0 w-full data-[open="false"]:hidden data-[open="true"]:bg-white data-[open="true"]:z-20 md:data-[open="false"]:block md:data-[open="false"]:bg-transparent md:data-[open="false"]:relative md:data-[open="true"]:hidden'
  id='home-menu'
  data-open='false'
>
  <ul class='flex flex-col md:flex-row py-2 md:py-0 xl:px-4 md:gap-4 lg:gap-8 xl:gap-12'>
    {
      sections.map((name, i) => (
        <li>
          <a
            href=''
            class='block py-4 text-xl md:text-base lg:text-lg font-medium text-center data-[active="true"]:text-primary hover:text-primary data-[active="true"]:hover:text-primary-dark data-[active="true"]:underline data-[active="true"]:underline-offset-12 data-[active="true"]:decoration-[3px] md:data-[active="true"]:decoration-[3.5px]'
            data-active={i == 0}
          >
            {name}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { $el } from '@lib/element-query'

  $el('#mobile-home-menu-button').on('click', () => $el('#home-menu').toggleData('open'))
</script>
